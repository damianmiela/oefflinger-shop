FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .

# NEXT_PUBLIC_* must be available at build time (baked into client bundle)
ARG NEXT_PUBLIC_WC_STORE_API
ARG NEXT_PUBLIC_WP_API_URL
ARG NEXT_PUBLIC_WP_URL
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_ALLOW_INDEXING
ENV NEXT_PUBLIC_WC_STORE_API=$NEXT_PUBLIC_WC_STORE_API
ENV NEXT_PUBLIC_WP_API_URL=$NEXT_PUBLIC_WP_API_URL
ENV NEXT_PUBLIC_WP_URL=$NEXT_PUBLIC_WP_URL
ENV NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_ALLOW_INDEXING=$NEXT_PUBLIC_ALLOW_INDEXING

RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "start"]
