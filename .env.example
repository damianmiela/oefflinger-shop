# Copy to .env. These values run the shop locally with docker/docker-compose.yml:
# storefront on http://localhost:4000, WordPress on http://localhost:4001.
# On a server, set real passwords and your own https addresses.

# MySQL
MYSQL_ROOT_PASSWORD=change_me_strong_password
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
MYSQL_PASSWORD=change_me_strong_password

# WordPress (DB host is overridden in compose)
WORDPRESS_DB_HOST=mysql
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=change_me_strong_password
WORDPRESS_DB_NAME=wordpress

# --- Headless layout -------------------------------------------------------
# WordPress (admin + REST + Store API + media) lives on its OWN address, the
# Next.js storefront on another. In production they are two subdomains of the
# same site, so the WP login cookie is still sent on the storefront's
# cross-origin API calls.
# ---------------------------------------------------------------------------

# WordPress setup (used by setup-woocommerce.sh). Also the WP backend's address.
WP_URL=http://localhost:4001
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change_me_strong_password
WP_ADMIN_EMAIL=admin@example.com

# CORS — storefront origin(s) allowed to call the Store/auth API with cookies.
CORS_ALLOWED_ORIGINS=http://localhost:4000

# "Zurück zum Shop" link target (storefront)
FRONTEND_URL=http://localhost:4000

# --- Email (SMTP) ----------------------------------------------------------
# Routes all wp_mail() (WooCommerce, password reset, newsletter, contact form)
# through an SMTP server. Provider-agnostic — swap to any SMTP host.
# Leave SMTP_HOST empty to disable (WordPress falls back to its default mailer).
#   SMTP_HOST: your mail server's hostname (connect by hostname, not by
#              container name or IP, so the TLS certificate matches).
#   SMTP_SECURE: tls = STARTTLS (587) | ssl = SMTPS (465) | empty = none
#   SMTP_VERIFY: 1 verifies the TLS cert (works when connecting by hostname);
#                set 0 only if connecting by IP/container name (cert mismatch).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Öfflinger
SMTP_VERIFY=1

# Frontend (NEXT_PUBLIC_* are BAKED into the build → rebuild after any change)
NEXT_PUBLIC_WP_API_URL=http://localhost:4001/wp-json
NEXT_PUBLIC_WP_URL=http://localhost:4001
NEXT_PUBLIC_WC_STORE_API=http://localhost:4001/wp-json/wc/store/v1

# Public base URL of the storefront – canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:4000
# Search-engine indexing: keep "false" until the shop really opens.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Optional: WooCommerce REST API (for attributes fallback)
# WC_CONSUMER_KEY=ck_xxx
# WC_CONSUMER_SECRET=cs_xxx

# Cloudflare Turnstile (bot protection on registration) – leave empty to disable
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
