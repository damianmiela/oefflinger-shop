# MySQL
MYSQL_ROOT_PASSWORD=change_me_strong_password
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
MYSQL_PASSWORD=change_me_strong_password

# WordPress (DB host is overridden in compose)
WORDPRESS_DB_HOST=mysql
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=change_me_strong_password
WORDPRESS_DB_NAME=wordpress

# WordPress setup (used by setup-woocommerce.sh)
WP_URL=http://91.98.112.186:4001
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change_me_strong_password
WP_ADMIN_EMAIL=admin@oefflinger.de

# CORS (comma-separated origins for headless frontend)
CORS_ALLOWED_ORIGINS=http://91.98.112.186:4000

# Checkout "Zurück zum Shop" link (WordPress)
FRONTEND_URL=http://91.98.112.186:4000

# Frontend (NEXT_PUBLIC_* are baked into build)
NEXT_PUBLIC_WP_API_URL=http://91.98.112.186:4001/wp-json
NEXT_PUBLIC_WP_URL=http://91.98.112.186:4001
NEXT_PUBLIC_WC_STORE_API=http://91.98.112.186:4001/wp-json/wc/store/v1

# Public base URL of the storefront – used for canonical URLs, sitemap and Open Graph.
# Production (at the cutover): https://oefflinger.de
NEXT_PUBLIC_SITE_URL=http://91.98.112.186:4000
# Search-engine indexing. Keep "false" (or empty) until launch; set to "true" at the
# oefflinger.de cutover to allow Google. See _docs/LAUNCH-SEO-UNBLOCK.md
NEXT_PUBLIC_ALLOW_INDEXING=false

# Optional: WooCommerce REST API (for attributes fallback)
# WC_CONSUMER_KEY=ck_xxx
# WC_CONSUMER_SECRET=cs_xxx

# Cloudflare Turnstile (bot protection on registration) – leave empty to disable
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
