# MySQL
MYSQL_ROOT_PASSWORD=change_me_strong_password
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
MYSQL_PASSWORD=change_me_strong_password

# WordPress (DB host is overridden in compose)
WORDPRESS_DB_HOST=mysql
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=change_me_strong_password
WORDPRESS_DB_NAME=wordpress

# --- Headless layout -------------------------------------------------------
# WordPress (admin + REST + Store API + media) lives on its OWN subdomain;
# the Next.js storefront stays on the apex. They are the same site, so the WP
# login cookie is still sent on the storefront's cross-origin API calls.
#   Storefront : https://oefflinger.de
#   WP backend : https://cms.oefflinger.de
# Pre-cutover dev values were http://91.98.112.186:4000 (FE) / :4001 (WP).
# ---------------------------------------------------------------------------

# WordPress setup (used by setup-woocommerce.sh). Also the WP backend's address.
WP_URL=https://cms.oefflinger.de
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change_me_strong_password
WP_ADMIN_EMAIL=admin@oefflinger.de

# CORS — storefront origin(s) allowed to call the Store/auth API with cookies.
CORS_ALLOWED_ORIGINS=https://oefflinger.de,https://www.oefflinger.de

# "Zurück zum Shop" link target (storefront)
FRONTEND_URL=https://oefflinger.de

# Frontend (NEXT_PUBLIC_* are BAKED into the build → rebuild after any change)
NEXT_PUBLIC_WP_API_URL=https://cms.oefflinger.de/wp-json
NEXT_PUBLIC_WP_URL=https://cms.oefflinger.de
NEXT_PUBLIC_WC_STORE_API=https://cms.oefflinger.de/wp-json/wc/store/v1

# Public base URL of the storefront – canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://oefflinger.de
# Search-engine indexing. "false" pre-launch; "true" at the oefflinger.de
# cutover to allow Google. See _docs/LAUNCH-SEO-UNBLOCK.md
NEXT_PUBLIC_ALLOW_INDEXING=true

# Optional: WooCommerce REST API (for attributes fallback)
# WC_CONSUMER_KEY=ck_xxx
# WC_CONSUMER_SECRET=cs_xxx

# Cloudflare Turnstile (bot protection on registration) – leave empty to disable
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
